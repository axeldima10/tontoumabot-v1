# Base URL du backend conversationnel (ex: http://localhost:8080).
# Le front appelle POST /api/v1/public/conversations puis .../{id}/messages.
VITE_TEXT_SESSION_URL=http://192.168.6.129:8080

# Optionnels : envoyés à la création de la conversation s'ils sont renseignés.
VITE_ORGANISATION_ID=
VITE_BORNE_ID=

# URL de base du serveur FastAPI WebSocket.
VITE_VOICE_SOCKET_URL=wss://tontoumabot.com
