# Base URL du backend conversationnel (ex: http://localhost:8080).
# Le front ajoute /api/v1/public/conversations/{conversationId}/messages.
VITE_TEXT_SESSION_URL=http://localhost:8080

# Optionnel : conserver un identifiant de conversation précis entre les rechargements.
VITE_CONVERSATION_ID=

# URL de base du serveur FastAPI WebSocket.
VITE_VOICE_SOCKET_URL=wss://tontoumabot.com
