# Base URL du backend conversationnel (ex: http://localhost:8080).
# Le front appelle POST /api/v1/public/conversations puis .../{id}/messages (texte)
# et .../{id}/messages/audio (voix, multipart + réponse SSE).
VITE_TEXT_SESSION_URL=http://192.168.6.129:8080

# Optionnels : sur une borne, l'organisation est connue d'avance (envoyée en organizationId).
# Sans elle, la conversation est créée à partir de la première question (ou d'une salutation à l'oral).
VITE_ORGANISATION_ID=
VITE_BORNE_ID=

